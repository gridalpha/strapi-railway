# Generated secrets — must stay stable across restarts.
# Rotating any of these invalidates existing tokens or encrypted data.
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Database — defaults to Railway's managed Postgres.
DATABASE_CLIENT=postgres
DATABASE_URL=
DATABASE_SSL=false

# Object storage. With all four set, media goes to S3 behind presigned URLs.
# Leave them unset to fall back to local uploads (needs a volume on public/uploads).
AWS_BUCKET=
AWS_ENDPOINT=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional overrides
# PUBLIC_URL=https://cms.example.com
# AWS_SIGNED_URL_EXPIRES=604800
# AWS_ACL=private
# AWS_FORCE_PATH_STYLE=true
HOST=0.0.0.0
PORT=1337
NODE_ENV=production
STRAPI_TELEMETRY_DISABLED=true
